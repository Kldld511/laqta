<Window x:Class="Laqta.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" Opacity="0"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">
    <Border Margin="18" Background="#F214171D" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,12,20,12" MinWidth="250">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Border x:Name="IconBg" Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentSoftBrush}">
                <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="17" Foreground="#B9A8FF" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="SubText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" FlowDirection="LeftToRight" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

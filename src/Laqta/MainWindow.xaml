<Window x:Class="Laqta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laqta" Width="1080" Height="790" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13.5" UseLayoutRounding="True"
        Icon="Assets/icon.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One audio track row -->
        <DataTemplate x:Key="TrackRow">
            <Border Padding="0,13" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" MinWidth="110" />
                        <ColumnDefinition Width="196" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="#B9A8FF" FontSize="17" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" Margin="0,0,18,0" VerticalAlignment="Center"
                              Visibility="{Binding OptionsVisibility}" ItemsSource="{Binding Options}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}" DropDownOpened="TrackCombo_DropDownOpened" />
                    <ProgressBar Grid.Column="3" Style="{StaticResource Meter}" Value="{Binding Level}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <Slider Grid.Column="4" Minimum="0" Maximum="2" LargeChange="0.1" Value="{Binding Gain, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding GainText}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" FlowDirection="LeftToRight" TextWrapping="NoWrap" />
                    <CheckBox Grid.Column="6" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="6,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One gallery card -->
        <DataTemplate x:Key="MediaCard">
            <Button Style="{StaticResource ActionTile}" Width="228" Margin="0,0,14,14" Padding="0" Click="Media_Click" Tag="{Binding}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource S_Open}" Click="MediaOpen_Click" />
                        <MenuItem Header="{DynamicResource S_ShowInFolder}" Click="MediaReveal_Click" />
                        <MenuItem Header="{DynamicResource S_Delete}" Click="MediaDelete_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Margin="-8,-6">
                    <Border Height="118" CornerRadius="9" Background="#0F1116" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="26" Foreground="#3A4050" />
                            <Border CornerRadius="9">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,3" CornerRadius="6" Background="#C0101216">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Kind}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Margin="2,10,2,0" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" />
                    <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,3,2,0" TextWrapping="NoWrap" FlowDirection="LeftToRight" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,20,14,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,28">
                        <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource BrandGradient}">
                            <Grid>
                                <Ellipse Width="20" Height="20" Stroke="White" StrokeThickness="3" />
                                <Ellipse Width="8" Height="8" Fill="#FF5C6E" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{DynamicResource S_AppName}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="#0CFFFFFF" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_Encoder}" Style="{StaticResource Muted}" FontSize="11.5" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse x:Name="EncoderDot" Width="7" Height="7" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="EncoderText" Text="—" FontSize="12.5" FontWeight="SemiBold" FlowDirection="LeftToRight" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="{DynamicResource S_Home}" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavGallery" Style="{StaticResource NavButton}" Tag="&#xE8B9;" Content="{DynamicResource S_Gallery}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="{DynamicResource S_Settings}" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ Content ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" />
                </StackPanel>

                <!-- ============ HOME ============ -->
                <ScrollViewer x:Name="HomePage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,0,30,30">

                        <!-- Status -->
                        <Border Style="{StaticResource Card}" Padding="24,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="StatusHalo" Width="22" Height="22" CornerRadius="11" Background="{StaticResource MintSoftBrush}" VerticalAlignment="Center">
                                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource MintBrush}" />
                                        </Border>
                                        <TextBlock x:Name="StatusTitle" FontSize="22" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="StatusSub" Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="TimerText" Grid.Column="1" Text="00:00" FontSize="40" FontWeight="Light" FontFamily="Segoe UI"
                                           VerticalAlignment="Center" FlowDirection="LeftToRight" Visibility="Collapsed" Margin="20,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Actions -->
                        <UniformGrid Columns="3" Margin="-7,14,-7,0">
                            <Button x:Name="RecordBtn" Style="{StaticResource ActionTile}" Margin="7,0" Click="Record_Click">
                                <DockPanel>
                                    <Border x:Name="RecordIconBg" DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="23" Background="{StaticResource RedSoftBrush}">
                                        <TextBlock x:Name="RecordIcon" Text="&#xE7C8;" Style="{StaticResource Icon}" Foreground="{StaticResource RedBrush}" FontSize="20" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Top" Background="#14FFFFFF" CornerRadius="6" Padding="7,3">
                                        <TextBlock x:Name="HkRecordChip" FontSize="11" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight" />
                                    </Border>
                                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="RecordLabel" Text="{DynamicResource S_Record}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource S_RecordHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button x:Name="ReplayBtn" Style="{StaticResource ActionTile}" Margin="7,0" Click="SaveReplay_Click">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="23" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Foreground="#B9A8FF" FontSize="20" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Top" Background="#14FFFFFF" CornerRadius="6" Padding="7,3">
                                        <TextBlock x:Name="HkReplayChip" FontSize="11" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight" />
                                    </Border>
                                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource S_SaveReplay}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource S_SaveReplayHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button x:Name="ShotBtn" Style="{StaticResource ActionTile}" Margin="7,0" Click="Screenshot_Click">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="23" Background="{StaticResource MintSoftBrush}">
                                        <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" Foreground="{StaticResource MintBrush}" FontSize="20" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Top" Background="#14FFFFFF" CornerRadius="6" Padding="7,3">
                                        <TextBlock x:Name="HkShotChip" FontSize="11" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight" />
                                    </Border>
                                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource S_Screenshot}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource S_ScreenshotHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </UniformGrid>

                        <!-- Instant replay -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{DynamicResource S_InstantReplay}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{DynamicResource S_InstantReplaySub}" Style="{StaticResource Muted}" Margin="0,5,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="ReplayLenCombo" Grid.Column="1" Width="150" VerticalAlignment="Center" Margin="0,0,18,0" SelectionChanged="ReplayLen_Changed" />
                                <CheckBox x:Name="ReplayToggle" Grid.Column="2" Style="{StaticResource Switch}" Click="ReplayToggle_Click" />
                            </Grid>
                        </Border>

                        <!-- Audio tracks -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="22,22,22,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_AudioTracks}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource S_AudioTracksSub}" Style="{StaticResource Muted}" Margin="0,5,0,14" />
                                <ItemsControl x:Name="TrackList" ItemTemplate="{StaticResource TrackRow}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ GALLERY ============ -->
                <Grid x:Name="GalleryPage" Grid.Row="1" Visibility="Collapsed" Margin="30,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,14,18">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Click="OpenFolder_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource S_OpenFolder}" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_Gallery}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{DynamicResource S_GallerySub}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MediaList" ItemTemplate="{StaticResource MediaCard}" Margin="0,0,0,20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="44" Foreground="#3A4050" />
                        <TextBlock Text="{DynamicResource S_Empty}" Style="{StaticResource Muted}" FontSize="14" Margin="0,14,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ============ SETTINGS ============ -->
                <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,0,30,30">
                        <TextBlock Text="{DynamicResource S_Settings}" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_VideoSection}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <DockPanel Margin="0,0,0,12">
                                    <ComboBox x:Name="MonitorCombo" DockPanel.Dock="Right" Width="230" SelectionChanged="Setting_Changed" />
                                    <TextBlock Text="{DynamicResource S_Monitor}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <ComboBox x:Name="FpsCombo" DockPanel.Dock="Right" Width="230" SelectionChanged="Setting_Changed" />
                                    <TextBlock Text="{DynamicResource S_Fps}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <ComboBox x:Name="QualityCombo" DockPanel.Dock="Right" Width="230" SelectionChanged="Setting_Changed" />
                                    <TextBlock Text="{DynamicResource S_Quality}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel>
                                    <CheckBox x:Name="CursorToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Setting_Clicked" />
                                    <TextBlock Text="{DynamicResource S_Cursor}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_AudioSection}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <DockPanel>
                                    <CheckBox x:Name="MixToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Setting_Clicked" />
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{DynamicResource S_IncludeMix}" />
                                        <TextBlock Text="{DynamicResource S_IncludeMixSub}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_OutputSection}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Content="{DynamicResource S_Browse}" Click="Browse_Click" Margin="12,0,0,0" />
                                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="12,0" Height="36">
                                        <TextBlock x:Name="OutputDirText" VerticalAlignment="Center" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_HotkeysSection}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="HkRecordBtn" DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Width="230" Tag="Record" Click="Hotkey_Click" />
                                    <TextBlock Text="{DynamicResource S_HkRecord}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="HkReplayBtn" DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Width="230" Tag="Replay" Click="Hotkey_Click" />
                                    <TextBlock Text="{DynamicResource S_HkReplay}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel>
                                    <Button x:Name="HkShotBtn" DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Width="230" Tag="Screenshot" Click="Hotkey_Click" />
                                    <TextBlock Text="{DynamicResource S_HkShot}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="HotkeyWarn" Text="{DynamicResource S_HotkeyTaken}" Foreground="{StaticResource RedBrush}" Margin="0,12,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_GeneralSection}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <DockPanel Margin="0,0,0,12">
                                    <ComboBox x:Name="LangCombo" DockPanel.Dock="Right" Width="230" SelectionChanged="Lang_Changed" />
                                    <TextBlock Text="{DynamicResource S_Language}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <CheckBox x:Name="SoundToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Setting_Clicked" />
                                    <TextBlock Text="{DynamicResource S_Sounds}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel>
                                    <CheckBox x:Name="TrayToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Setting_Clicked" />
                                    <TextBlock Text="{DynamicResource S_Tray}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
